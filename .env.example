# Salin jadi .env.local untuk development, atau isi di Vercel > Settings > Environment Variables

# Postgres dari Neon (Vercel > Storage > Create Database > Neon). Otomatis terisi kalau disambung dari Vercel.
DATABASE_URL=

# String acak minimal 32 karakter untuk mengamankan sesi login
# (buat dengan: openssl rand -base64 32)
SESSION_SECRET=

# --- Login dengan Google / Discord ---
# Redirect URI yang didaftarkan: https://<domain>/api/auth/callback/google
#                                https://<domain>/api/auth/callback/discord
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Siapa yang boleh masuk (pisahkan dengan koma). Akun lain ditolak walau login-nya berhasil.
ALLOWED_EMAILS=
ALLOWED_DISCORD_IDS=

# Opsional: password cadangan. Kosongkan untuk mematikan login password.
ADMIN_PASSWORD=
