# Salin jadi .env.local untuk development, atau isi di Vercel > Settings > Environment Variables

# Postgres dari Neon (Vercel > Storage > Create Database > Neon). Otomatis terisi kalau disambung dari Vercel.
DATABASE_URL=

# Password untuk masuk dashboard
ADMIN_PASSWORD=

# String acak minimal 32 karakter untuk mengamankan sesi login
# (buat dengan: openssl rand -base64 32)
SESSION_SECRET=
